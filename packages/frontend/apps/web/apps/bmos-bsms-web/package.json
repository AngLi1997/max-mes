    "@bmos/icons": "workspace:^",
    "@bmos/messager": "workspace:^",
    "@bmos/utils": "workspace:^",
    "ant-design-vue": "^4.2.6",
    "echarts": "^5.5.0",
    "echarts-wordcloud": "^2.1.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.6",
    "vue": "3.5.12",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vue/tsconfig": "^0.4.0",
    "dayjs": "^1.11.10",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.0.6",
    "typescript": "~5.2.0",
    "unplugin-auto-import": "^0.16.6",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^5.3.1",
