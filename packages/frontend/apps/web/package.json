{
  "name": "monorepo-demo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "scripts": {
    "build": "pnpm --filter ./apps/** build",
    "build:audit": "pnpm --filter bmos-audit-web build",
    "build:dc": "pnpm --filter bmos-dc-web build",
    "build:ems": "pnpm --filter bmos-ems-web build",
    "build:lims": "pnpm --filter bmos-lims-web build",
    "build:mes": "pnpm --filter bmos-mes-web build",
    "build:packages": "pnpm --filter ./packages/** run build",
    "build:platform": "pnpm --filter bmos-platform-web build",
    "build:wms": "pnpm --filter bmos-wms-web build",
    "dev": "pnpm --filter ./apps/** run dev",
    "dev:mes": "pnpm --filter bmos-mes-web run dev",
    "dev:plat": "pnpm --filter bmos-platform-web run dev",
    "i18n": "node ./scripts/i18n.js",
    "preinstall": "node -v",
    "lint-staged": "lint-staged",
    "lint:script": "eslint --ext .js,.jsx,.ts,.tsx,.vue --fix ./",
    "lint:style": "stylelint --fix ./**/*.{css,less,vue,html}",
    "open": "pnpm --filter @bmos/open start",
    "prepare": "node scripts/husky-install.js",
    "serve": "pnpm --filter ./apps/** run serve",
    "start": "pnpm --filter ./apps/** run start"
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,md,json}": "eslint --fix",
    "*.{css,less,vue,html}": "stylelint --fix --allow-empty-input"
  },
  "dependencies": {
    "@antv/g6": "^5.0.32",
    "@antv/g6-extension-react": "^0.1.7",
    "@tinymce/tinymce-vue": "^6.1.0",
    "@zwight/g6-extension-vue": "^0.0.6",
    "axios": "^1.4.0",
    "file-saver": "^2.0.5",
    "qs": "^6.12.0",
    "tinymce": "^5.6.1",
    "vue": "3.5.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/node": "^20.5.1",
    "@types/react": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.56.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.24.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "postcss-html": "^1.5.0",
    "postcss-scss": "^4.0.8",
    "prettier": "^3.0.2",
    "prettier-plugin-organize-imports": "^3.2.3",
    "prettier-plugin-packagejson": "^2.4.5",
    "stylelint": "^16.1.0",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-recess-order": "^5.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-less": "^3.0.1",
    "stylelint-less": "^3.0.1",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.2",
    "stylelint-processor-html": "^1.0.0",
    "typescript": "^5.1.6",
    "vite": "^5.3.1",
    "vue-eslint-parser": "^9.4.2"
  },
  "packageManager": "pnpm@8.5.0",
  "engines": {
    "node": ">= 20.15"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vite"
      ]
    }
  }
}
