<?xml version="1.0" encoding="UTF-8"?>
<mappings xmlns="http://dozer.sourceforge.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://dozer.sourceforge.net
          http://dozer.sourceforge.net/schema/beanmapping.xsd">
    <mapping date-format="yyyy-MM-dd" map-id="HlInspectOrderSendBack">
        <class-a>com.bmos.api.server.open.lims.dto.InspectOrderSendBackDTO</class-a>
        <class-b>com.bmos.mes.inspect.dto.InspectRejectDTO</class-b>
        <field>
            <a>mesSerialNo</a>
            <b>inspectNo</b>
        </field>
        <field>
            <a>backReason</a>
            <b>reason</b>
        </field>
    </mapping>

    <mapping date-format="yyyy-MM-dd" map-id="HlInspectResultSendBack">
        <class-a>com.bmos.api.server.open.lims.dto.InspectResultSendBackDTO</class-a>
        <class-b>com.bmos.mes.inspect.dto.InspectResultCallBackDTO</class-b>
        <field>
            <a>mesSerialNo</a>
            <b>inspectNo</b>
        </field>
        <field>
            <a>serialResult</a>
            <b>result</b>
        </field>
        <field>
            <a>isClose</a>
            <b>closed</b>
        </field>
    </mapping>
    <mapping date-format="yyyy-MM-dd" map-id="HlInspectResultSendBackItem">
        <class-a>com.bmos.api.server.open.lims.dto.InspectResultItemDTO</class-a>
        <class-b>com.bmos.mes.inspect.dto.InspectResultItemDTO</class-b>
        <field custom-converter="com.bmos.api.server.converter.HlInspectResultSendBackConverter">
            <a>testCode</a>
            <b>alreadyConvertProgramNo</b>
        </field>
        <field>
            <a>testCode</a>
            <b>inspectProgramNo</b>
        </field>
        <field>
            <a>testNo</a>
            <b>inspectProgramName</b>
        </field>
        <field>
            <a>testResult</a>
            <b>inspectResult</b>
        </field>
        <field>
            <a>testConclusion</a>
            <b>inspectConclusion</b>
        </field>
    </mapping>

    <mapping date-format="yyyy-MM-dd" map-id="HlInspectOrderSend">
        <class-a>com.alibaba.fastjson.JSONObject</class-a>
        <class-b>com.bmos.api.server.outer.lims.dto.InspectRequestOrderDTO</class-b>
        <field>
            <a>pleaseCheckNo</a>
            <b>REQUESTID</b>
        </field>
        <field>
            <a>productLineName</a>
            <b>REQUEST_DEPT</b>
        </field>
        <field>
            <a>sampleQuantity</a>
            <b>ACTUALVOL</b>
        </field>
        <field>
            <a>materialCode</a>
            <b>MATCODE</b>
        </field>
        <field>
            <a>sampleQuantityUnitName</a>
            <b>ACTUALVOL_UNITS</b>
        </field>
        <field>
            <a>inspector</a>
            <b>REQUESTER</b>
        </field>
        <field>
            <a>productBatchNo</a>
            <b>BATCHNO</b>
        </field>
        <field>
            <a>productBatchQuantity</a>
            <b>ESTIMATEDVOL</b>
        </field>
        <field>
            <a>materialName</a>
            <b>MATNAME</b>
        </field>
        <field>
            <a>materialBatchNo</a>
            <b>MATBATCHNO</b>
        </field>
        <field>
            <a>productBatchQuantityUnit</a>
            <b>ESTIMATEDVOL_UNITS</b>
        </field>
        <field>
            <a>instructionNo</a>
            <b>ORDER_NUMBER</b>
        </field>
        <field>
            <a>remark</a>
            <b>COMMENTS</b>
        </field>
        <!-- 这里对应请验单自定义字段转换为疫苗LIMS的字段 需要根据LIMS自定义请验单做修改-->
        <field>
            <a>1212</a>
            <b>TESTNO</b>
        </field>
        <field>
            <a>c1</a>
            <b>PROCESS</b>
        </field>
        <field>
            <a>c2</a>
            <b>REQUEST_REASON</b>
        </field>
        <field>
            <a>c3</a>
            <b>PRODUCTION_DATE</b>
        </field>
        <field>
            <a>c4</a>
            <b>RETENTIONSAMPLEVOL</b>
        </field>
        <field>
            <a>c5</a>
            <b>RETENTIONSAMPLE_UNITS</b>
        </field>
        <field>
            <a>c6</a>
            <b>CREATE_DEPT</b>
        </field>
    </mapping>
</mappings>
