<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.platform.service.equipment.mapper.EquipmentTagMapper">
    <select id="selectChildren" resultType="com.bmos.platform.service.equipment.model.EquipmentTag">
        SELECT *
        FROM bp_equipment_tag
        WHERE parent_id = #{parentId}
    </select>
</mapper>
