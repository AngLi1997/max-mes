<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.platform.service.system.dept.mapper.DeptRelateUserMapper">


    <select id="selectDeptIdsByUserId" resultType="java.lang.Long">
        select distinct
            dept_id
        from bp_user_dept
        where is_deleted = false
        <if test="userId != null and userId != '1' and userId != ''">
            and user_id = #{userId}
        </if>
    </select>
</mapper>
