<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.platform.service.message.mapper.MessageInfoMapper">


    <select id="selectUserMessageList"
            resultType="com.bmos.platform.service.message.entity.entity.MessageInfo">
        select bmi.*
        from bp_message_info bmi,
        bp_message_user bmu
        where bmi.id = bmu.message_id
        and bmi.is_deleted = 0
        and bmu.is_deleted = 0
        <if test="userId != null and userId != ''">
            and bmu.user_id = #{userId}
        </if>
        <if test="messageType != null and messageType.size() > 0">
            and bmi.msg_type in
            <foreach collection="messageType" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="messageStatus != null">
            and bmu.msg_status = #{messageStatus}
        </if>
    </select>
</mapper>
