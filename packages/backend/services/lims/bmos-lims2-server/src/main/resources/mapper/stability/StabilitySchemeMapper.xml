<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.lims2.server.stability.scheme.mapper.StabilitySchemeMapper">

    <resultMap id="BaseResultMap" type="com.bmos.lims2.server.stability.scheme.entity.StabilityScheme">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="material_id" property="materialId"/>
        <result column="material_name" property="materialName"/>
        <result column="material_code" property="materialCode"/>
        <result column="active_version_no" property="activeVersionNo"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="is_deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, code, material_id, material_name, material_code, active_version_no,
        create_time, update_time, create_by, update_by, is_deleted, tenant_id
    </sql>

    <select id="selectSchemeList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lm_stability_scheme
        WHERE is_deleted = 0
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="code != null and code != ''">
            AND code LIKE CONCAT('%', #{code}, '%')
        </if>
        <if test="materialId != null">
            AND material_id = #{materialId}
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lm_stability_scheme
        WHERE code = #{code} AND is_deleted = 0
    </select>

    <select id="selectByMaterialId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lm_stability_scheme
        WHERE material_id = #{materialId} AND is_deleted = 0
    </select>

</mapper>
