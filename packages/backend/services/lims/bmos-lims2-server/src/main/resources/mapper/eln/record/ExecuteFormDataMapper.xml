<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.lims2.server.eln.entry.mapper.ExecuteFormDataMapper">


    <select id="selectMaxRev" resultType="java.lang.Long">
        select
        max(rev)
        from bm_execute_form_data
        where
        inspection_order_id = #{inspectionOrderId}
        and field_id in
        <foreach collection="fields" open="(" separator="," close=")" item="item">
            #{item}
        </foreach>
    </select>


</mapper>
