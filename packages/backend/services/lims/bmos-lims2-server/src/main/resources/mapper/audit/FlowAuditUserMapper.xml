<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.lims2.server.audit.mapper.FlowAuditUserMapper">

    <delete id="deleteByNodeIdListAndDeploymentId">
        DELETE FROM
            lm_flow_audit_user
        WHERE
	        is_deleted = 0
	    AND node_id IN
        <foreach collection="nodeIdList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
        and deployment_id=#{deploymentId}
    </delete>

</mapper>
