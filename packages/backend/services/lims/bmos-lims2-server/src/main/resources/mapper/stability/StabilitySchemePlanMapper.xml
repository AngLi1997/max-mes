<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.lims2.server.stability.scheme.mapper.StabilitySchemePlanMapper">

    <select id="selectByVersionId" resultType="com.bmos.lims2.server.stability.scheme.entity.StabilitySchemePlan">
        SELECT * FROM lm_stability_scheme_plan
        WHERE version_id = #{versionId} AND is_deleted = 0
        ORDER BY sort ASC, create_time ASC
    </select>

    <delete id="deleteByVersionId">
        DELETE FROM lm_stability_scheme_plan WHERE version_id = #{versionId}
    </delete>

</mapper>
