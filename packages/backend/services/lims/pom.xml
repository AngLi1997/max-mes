<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bmos.lims</groupId>
    <artifactId>bmos-lims2</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>bmos-lims2</name>
    <modules>
        <module>bmos-lims2-common</module>
        <module>bmos-lims2-feign</module>
        <module>bmos-lims2-server</module>
        <module>bmos-lims2-web</module>
    </modules>

    <properties>
        <revision>1.0-SNAPSHOT</revision>
        <bmos.version>1.15.2-SNAPSHOT</bmos.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <druid.version>1.2.8</druid.version>
        <mysql.version>8.0.32</mysql.version>
        <mapstruct.version>1.4.1.Final</mapstruct.version>
        <flyway.version>8.0.5</flyway.version>
        <lombok.version>1.18.20</lombok.version>
        <flatten-maven-plugin.version>1.5.0</flatten-maven-plugin.version>
        <mybatis-puls.version>3.5.3.2</mybatis-puls.version>
        <docx4j.version>8.3.9</docx4j.version>
        <poi.version>5.2.3</poi.version>
        <easyexcel.version>3.3.2</easyexcel.version>
        <spring.cloud.version>3.1.8</spring.cloud.version>
        <fastjson.version>1.2.83</fastjson.version>
        <platform-facade.version>1.0.1.20251020-SNAPSHOT</platform-facade.version>
        <bmos-scheduler.version>1.0.0.20240411-SNAPSHOT</bmos-scheduler.version>
        <dynamic-dataSource.version>3.4.1</dynamic-dataSource.version>
        <shardingsphere.version>5.5.1</shardingsphere.version>
        <snakeyaml.version>1.33</snakeyaml.version>
        <mybatis.puls.version>3.5.3.2</mybatis.puls.version>
        <spring.webservice.version>2.6.15</spring.webservice.version>
        <dozer.version>6.5.0</dozer.version>
        <mes.feign.version>1.0.1.20250218-SNAPSHOT</mes.feign.version>
        <bmos-audit-engine.version>0.0.3-SNAPSHOT</bmos-audit-engine.version>
        <bmos-flow-engine.version>0.0.5-SNAPSHOT</bmos-flow-engine.version>
        <minio.version>8.2.2</minio.version>
        <docx4j.version>8.3.8</docx4j.version>
        <jsoup.version>1.17.2</jsoup.version>



    </properties>




    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-cloud-dependency</artifactId>
                <version>${bmos.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-starter-adaptor</artifactId>
                <version>${bmos.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-starter-common</artifactId>
                <version>${bmos.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-web-services -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web-services</artifactId>
                <version>${spring.webservice.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-scheduler-core</artifactId>
                <version>${bmos-scheduler.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-starter-autoconfigure</artifactId>
                <version>${bmos.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus</artifactId>
                <version>${mybatis-puls.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-logging</artifactId>
                    </exclusion>
                </exclusions>
                <scope>test</scope>
                <version>2.6.15</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>${fastjson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-platform-facade</artifactId>
                <version>${platform-facade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-starter-data</artifactId>
                <version>${bmos.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-starter-file</artifactId>
                <version>${bmos.version}</version>
            </dependency>
            <dependency>
                <groupId>org.docx4j</groupId>
                <artifactId>docx4j-JAXB-MOXy</artifactId>
                <version>${docx4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-mes-feign</artifactId>
                <version>${mes.feign.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos.audit.engine</groupId>
                <artifactId>bmos-audit-engine-starter</artifactId>
                <version>${bmos-audit-engine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bmos.orchestrator.engine</groupId>
                <artifactId>bmos-orchestrator-starter</artifactId>
                <version>${bmos-flow-engine.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>2.0.27</version>
            </dependency>
            <dependency>
                <groupId>com.bmos</groupId>
                <artifactId>bmos-starter-formula</artifactId>
                <version>${bmos.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>



    <build>
        <plugins>
            <!-- maven-compiler-plugin 插件，解决 Lombok + MapStruct 组合 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 统一 revision 版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>bmos-maven</id>
            <name>internal releases</name>
            <url>http://172.30.1.212:8081/repository/maven-releases</url>
        </repository>
        <snapshotRepository>
            <id>bmos-maven</id>
            <name>internal snapshot</name>
            <url>http://172.30.1.212:8081/repository/maven-snapshots</url>
        </snapshotRepository>
    </distributionManagement>
</project>