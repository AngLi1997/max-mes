<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>bmos-lims2</artifactId>
        <groupId>com.bmos.lims</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>bmos-lims2-feign</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-cloud-dependency</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-starter-adaptor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos.lims</groupId>
            <artifactId>bmos-lims2-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-starter-common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>bmos-api-feign</finalName>
        <plugins>
            <!-- maven-compiler-plugin 插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>bmos-maven</id>
            <name>internal releases</name>
            <url>http://172.30.1.212:8081/repository/maven-releases</url>
        </repository>
        <snapshotRepository>
            <id>bmos-maven</id>
            <name>internal snapshot</name>
            <url>http://172.30.1.212:8081/repository/maven-snapshots</url>
        </snapshotRepository>
    </distributionManagement>

</project>