<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bmos.wms</groupId>
        <artifactId>bmos-wms</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>bmos-wms-service</artifactId>
    <name>bmos-wms-service</name>

    <dependencies>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-cloud-dependency</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-starter-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-starter-formula</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-starter-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos.orchestrator.engine</groupId>
            <artifactId>bmos-orchestrator-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos.audit.engine</groupId>
            <artifactId>bmos-audit-engine-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bmos.wms</groupId>
            <artifactId>bmos-wms-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-platform-facade</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-scheduler-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-log4j-2.x</artifactId>
            <version>9.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-trace</artifactId>
            <version>9.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-starter-data</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-autoconfigure</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- LIMS2 feign 契约（调用 LIMS） -->
        <dependency>
            <groupId>com.bmos.lims</groupId>
            <artifactId>bmos-lims2-feign</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- WMS feign 契约（被 LIMS 回调） -->
        <dependency>
            <groupId>com.bmos</groupId>
            <artifactId>bmos-wms-feign</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>bmos-wms-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>2.6.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 适配公司jenkins部署-start -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>copy</id>
                        <phase>package</phase>
                        <configuration>
                            <tasks>
                                <copy todir="../jar">
                                    <fileset dir="${project.build.directory}">
                                        <include name="*.jar"/>
                                    </fileset>
                                </copy>
                            </tasks>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 适配公司jenkins部署-end -->
        </plugins>
    </build>
</project>
