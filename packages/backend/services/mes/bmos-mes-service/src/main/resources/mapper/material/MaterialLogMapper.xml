<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.mes.service.product.mapper.MaterialLogMapper">

    <select id="selectPageVOList" resultMap="BaseResultMap">
        select * from bm_material_log
        where 1 = 1
        <if test="null != dto.categoryType">
            and category_type = #{dto.categoryType}
        </if>
        <if test="null != dto.materialId ">
            and material_id = #{dto.materialId}
        </if>
        <if test="null != dto.materialBatchId ">
            and material_batch_id = #{dto.materialBatchId}
        </if>
        <if test="null != dto.storageMaterialId ">
            and storage_material_id = #{dto.storageMaterialId}
        </if>
        <if test="opList != null and opList.size() > 0">
            and operation_type in
            <foreach collection="opList" item="op" open="(" separator="," close=")">
                #{op}
            </foreach>
        </if>
        <if test="dto.startTimeDate != null and dto.endTimeDate != null">
            and operation_time between #{dto.startTimeDate} and #{dto.endTimeDate}
        </if>
        order by operation_time desc
    </select>

    <resultMap id="BaseResultMap" type="com.bmos.mes.service.product.vo.MaterialLogPageVO" >
        <result column="id" property="id" />
        <result column="operation_time" property="operationTime" />
        <result column="operation_type" property="operationType" />
        <result column="specific_operation_type" property="specificOperationType" />
        <result column="user_name" property="userName" />
        <result column="login_name" property="loginName" />
        <result column="material_name" property="materialName" />
        <result column="material_code" property="materialCode" />
        <result column="material_batch_no" property="materialBatchNo" />
        <result column="material_no" property="materialNo" />
        <result column="scheduled" property="scheduled" />
        <result column="available" property="available" />
        <result column="tare_weight" property="tareWeight" />
        <result column="gross_weight" property="grossWeight" />
        <result column="unit_name" property="unitName" />
        <result column="expiration_time" property="expirationTime" />
        <result column="product_name" property="productName" />
        <result column="product_merge_code" property="productMergeCode" />
        <result column="batch_no" property="batchNo" />
        <result column="material_position_name" property="materialPositionName" />
        <result column="material_position_code" property="materialPositionCode" />
        <result column="material_position_path" property="materialPositionPath" />
        <result column="inspect_id" property="inspectId" />
        <result column="expand_info" property="expandInfo" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="original_code" property="originalCode" />
        <result column="original_no" property="originalNo" />
        <result column="request_verify_no" property="requestVerifyNo" />
        <result column="report_no" property="reportNo" />
        <result column="remark" property="remark"/>
        <result column="enable" property="enable"/>
    </resultMap>
</mapper>
