<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.mes.service.process.mapper.ProcedureModelRoomMapper">

    <select id="selectRoomIdByModelIds" resultType="com.bmos.mes.service.process.vo.ProcessConfigVO">
        SELECT
            room_id as configId,
            room_id_path as roomIdPath
        FROM
            bm_procedure_model_room
        WHERE
            procedure_model_id in
        <foreach collection="modelIds" separator="," open="(" close=")" item="modelId">
            #{modelId}
        </foreach>
    </select>
</mapper>
