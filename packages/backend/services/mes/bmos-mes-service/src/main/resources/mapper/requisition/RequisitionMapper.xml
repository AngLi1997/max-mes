<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.mes.service.requisition.mapper.RequisitionMapper">

    <select id="selectMaxSerialNo" resultType="java.lang.Integer">
        select MAX(serial_no) from bm_requisition_plan
        where product_plan_id = #{productPlanId}
    </select>
</mapper>
