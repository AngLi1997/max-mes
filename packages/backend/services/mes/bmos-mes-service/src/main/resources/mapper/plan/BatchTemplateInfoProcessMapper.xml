<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.mes.service.plan.document.mapper.BatchTemplateInfoProcessMapper">


    <select id="selectProcessIdListByTemplateId" resultType="java.lang.Long">
        SELECT
            process_id
        FROM
            bm_batch_template_info_process
        <if test="templateId != null">
            where batch_template_info_id = #{templateId}
        </if>
        GROUP BY
            process_id
    </select>
    <select id="selectAllProcessIds" resultType="java.lang.Long">
        select distinct process_id from bm_batch_template_info_process
    </select>

</mapper>
