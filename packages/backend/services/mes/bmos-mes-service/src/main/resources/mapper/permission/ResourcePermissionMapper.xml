<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.mes.service.permission.mapper.ResourcePermissionMapper">

    <select id="selectDeptIdsByResourceId" resultType="java.lang.Long">
        select
            dept_id
        from bm_resource_permission
        where resource_id = #{resourceId}
    </select>
</mapper>
