<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bmos.mes.service.lotrelease.template.mapper.ILotReleaseTemplateProcessRelationMapper">
    <select id="selectAllProcessIdsByTemplateId" resultType="java.lang.Long">
        select distinct process_id
        from bm_lot_release_template_process
        <if test="templateId != null">
            where lot_release_template_id = #{templateId}
        </if>
    </select>
</mapper>